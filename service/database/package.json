{
  "name": "@service/database",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./prisma/generated/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm prisma:generate",
    "sync": "tsx scripts/sync.ts",
    "dev": "tsdown --watch",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate && pnpm sync && tsdown",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:format": "prisma format",
    "prisma:studio": "prisma studio",
    "prisma:db:push": "prisma db push",
    "prisma:db:pull": "prisma db pull"
  },
  "dependencies": {
    "@prisma/adapter-pg": "catalog:sql",
    "@prisma/client": "catalog:sql",
    "@prisma/client-runtime-utils": "7.8.0"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "prisma": "catalog:sql",
    "tsdown": "catalog:cli",
    "tsx": "catalog:cli"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./client": "./dist/client.mjs",
      "./package.json": "./package.json"
    }
  }
}
