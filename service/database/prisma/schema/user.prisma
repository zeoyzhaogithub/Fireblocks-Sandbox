/// ======================================================
/// 1. User Management
/// 职责：
/// - 用户主档（User）：登录标识、资料、状态、邀请关系
/// - 与 Fireblocks 金库账户 ID 绑定（vault_account_id）
/// 典型业务时机：
/// - 注册、登录资料变更、邀请码绑定、账户启用/暂停
/// 依赖关系：
/// - 被 KYC、KYT、Authenticator、VaultAsset、Asset 等通过 user_id 关联
/// ======================================================

model User {
  /// Unique identifier (UUID)
  id               String      @id @default(uuid())
  /// Primary login credential
  email            String      @unique
  /// Display name
  username         String
  /// Optional user alias
  nickname         String?
  /// URL to the user profile image
  avatar           String?
  /// Hashed password string
  password         String
  /// Account lifecycle status
  status           UserStatus  @default(ACTIVE)

  // --- Referral System ---
  /// Unique referral code for the user
  invite_code      String?     @unique
  /// ID of the user who invited this user
  inviter_id       String?
  /// Self-relation for the inviter
  inviter          User?       @relation("UserReferrals", fields: [inviter_id], references: [id])
  /// List of users invited by this user
  invited_users    User[]      @relation("UserReferrals")

  // --- KYC/KYT Relation ---
  /// One-to-one link to KYC verification data
  kyc              Kyc?
  /// One-to-many link to KYT alerts
  kyt              Kyt[]

  // --- External Integrations ---
  /// Unique ID for Fireblocks vault
  vault_account_id String
  /// Assets associated with the Fireblocks vault
  vault_assets     VaultAsset[]
  /// Internal platform assets/balances
  assets           Asset[]
  /// Security authenticators (TOTP, Email, etc.)
  authenticators   Authenticator[]
  /// 用户名下卡片（与发卡渠道的数据镜像）
  cards              Card[]
  /// 钱包 / 托管通用流水（充值、归集、申卡费等）
  transactions       Transaction[]
  /// 钱包代币换法币并入卡余额的充卡单（与 Transaction 分表）
  card_wallet_top_ups CardWalletTopUp[]
  /// 从 Fireblocks 接口同步的托管交易快照（对账 / 幂等）
  fb_tx_snapshots    FireblocksTransactionSnapshot[]

  // --- Timestamps ---
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt

  @@map("users")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}
