// ------------------------------------------------------
// 1. User Management
// ------------------------------------------------------
enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

/// ========== 域1：用户认证 ==========
model User {
  id       String     @id @default(uuid())
  email    String     @unique
  username String
  nickname String?
  avatar   String?
  password String
  status   UserStatus @default(PENDING)

  // 邀请码
  invite_code      String?
  inviter_id       String?
  /// Fireblocks 金库账户 ID（Vault Account ID，一用户一个，可选）。
  vault_account_id String? @unique

  sessions UserSession[]

  // KYC Relations
  kyc Kyc? @relation("user_kyc")

  custody_deposit_addresses CustodyWalletDepositAddress[]
  /// 用户内部钱包账户（反向关系），便于从用户直接读取账户状态、风控信息与账户编号。
  wallet_account            WalletAccount?

  authenticators Authenticator[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("users")
}

/// 用户会话表，用于存储用户登录会话信息。
model UserSession {
  id            String   @id @default(cuid())
  user_id       String
  token         String   @unique
  refresh_token String?
  ip_address    String?
  user_agent    String?
  expires_at    DateTime
  last_used_at  DateTime @default(now())
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("user_sessions")
}

model Authenticator {
  id      Int    @id @default(autoincrement())
  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  type            AuthenticatorType
  // --- Core ---
  secret          String? // TOTP secret / Hashed code
  identifier      String? // EMAIL: Email address / TELEGRAM_OTP: Phone number or Telegram ID
  // --- Status ---
  verified        Boolean           @default(false)
  enabled         Boolean           @default(false)
  // --- Security ---
  failed_attempts Int               @default(0)
  locked_until    DateTime?
  backup_codes    String? // TOTP backup codes (JSON array encrypted storage)

  // --- timestamp ---
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id])
  @@index([user_id, type])
}

enum AuthenticatorType {
  TOTP // Time-based OTP (Google Authenticator)
  TELEGRAM_OTP // Telegram OTP (SMS)
  EMAIL // Email OTP
}

model Kyc {
  id               Int       @id @default(autoincrement())
  user_id          String?
  external_user_id String // Sumsub external user ID, now Use user ID
  applicant_id     String // Sumsub applicant ID
  status           KycStatus @default(INITIAL)

  level_name      String?
  review_status   String?
  review_result   String?
  sandbox_mode    Boolean?
  event_update_at DateTime? @db.Timestamptz(3)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User? @relation("user_kyc", fields: [user_id], references: [id])

  @@unique([user_id])
}

enum KycStatus {
  INITIAL // Initial state
  PENDING // Under review
  REJECTED // Rejected (RED with FINAL)
  COMPLETED // Successfully verified (GREEN)
  RETRY // Can RETRY
}

/// ========== 域2：托管地址 ==========

/// 保存 Fireblocks 返回的用户充值地址信息。
/// 约束为同一用户在同一资产 legacy id 下仅保留一条主记录。
model CustodyWalletDepositAddress {
  id          String   @id @default(cuid())
  /// 平台用户 ID（users.id）。
  user_id     String
  /// Fireblocks 资产标识（Asset ID，例如 TRX、TON、USDT_TRX）。
  asset_id    String
  /// 网络标识（如 TRON、TON，可选）。
  network_key String?
  /// 链上充值地址。
  address     String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, network_key, asset_id])
  @@index([address])
  @@map("custody_wallet_deposit_addresses")
}

/// ========== 域3：钱包账务 ==========
/// 用户内部钱包账户主表（产品层账户，不等同 Fireblocks Vault）。
model WalletAccount {
  id                   String                @id @default(cuid())
  user_id              String                @unique
  user                 User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  /// 账户资产余额快照列表（按资产维度）。
  balances             WalletBalance[]
  /// 账户资金流水列表（总账）。
  ledger_entries       WalletLedgerEntry[]
  cardOperationRecords CardOperationRecord[]

  @@map("wallet_accounts")
}

/// 用户资产余额快照表（按账户 + 资产）。
model WalletBalance {
  id                String        @id @default(cuid())
  /// 钱包账户 ID（wallet_accounts.id）。
  wallet_account_id String
  /// 资产代码（如 USDT、TON）。
  asset_code        String
  /// 可用余额（可用于提现/消费/转账）。
  available         Decimal       @db.Decimal(36, 18)
  /// 冻结余额（风控冻结、处理中金额等）。
  frozen            Decimal       @default(0) @db.Decimal(36, 18)
  /// 记录创建时间。
  created_at        DateTime      @default(now())
  /// 记录更新时间（余额变更时自动更新）。
  updated_at        DateTime      @updatedAt
  /// 归属钱包账户关系。
  wallet_account    WalletAccount @relation(fields: [wallet_account_id], references: [id], onDelete: Cascade)

  @@unique([wallet_account_id, asset_code])
  @@index([asset_code])
  @@map("wallet_balances")
}

enum LedgerEntryType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  FEE
}

enum LedgerEntryStatus {
  PENDING
  POSTED
  FAILED
  REVERSED
}

/// 资金流水总账（统一记录入金、出金、划转、调账等资金变化）。
model WalletLedgerEntry {
  id                String              @id @default(cuid())
  /// 钱包账户 ID（wallet_accounts.id）。
  wallet_account_id String
  /// 流水类型（入金/出金/手续费/调账等）。
  entry_type        LedgerEntryType
  /// 流水状态（待处理/已入账/失败/冲正）。
  status            LedgerEntryStatus   @default(PENDING)
  /// 资产代码（如 USDT、TON）。
  asset_code        String
  /// 变动金额
  amount            Decimal             @db.Decimal(36, 18)
  /// 手续费金额（可选）。
  fee_amount        Decimal?            @db.Decimal(36, 18)
  /// 业务类型（多态关联类型，如 WALLET_FLOW_RECORD / CARD_OPERATION_RECORD / SWEEP_TRANSFER）。
  business_type     LedgerBusinessType?
  /// 业务主键 ID（对应业务表记录 ID）。
  business_id       String?
  /// 幂等键（避免重复记账）。
  idempotency_key   String?             @unique
  /// 记录创建时间。
  created_at        DateTime            @default(now())
  /// 记录更新时间。
  updated_at        DateTime            @updatedAt
  /// 归属钱包账户关系。
  wallet_account    WalletAccount       @relation(fields: [wallet_account_id], references: [id], onDelete: Cascade)

  @@index([wallet_account_id, asset_code, created_at])
  @@index([business_type, business_id])
  @@map("wallet_ledger_entries")
}

enum LedgerBusinessType {
  WALLET_FLOW_RECORD
  CARD_OPERATION_RECORD
  SWEEP_TRANSFER
  ADJUSTMENT
}

enum WalletFlowType {
  DEPOSIT
  WITHDRAWAL
}

enum WalletFlowStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// 卡操作资金记录状态
enum CardOperationRecordStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}

/// 钱包资金变更记录（充值/提现表）。
model WalletFlowRecord {
  id                String           @id @default(cuid())
  /// 平台钱包账户 ID（wallet_accounts.id）。
  wallet_account_id String
  /// 资金变更类型（充值/提现）。
  flow_type         WalletFlowType
  /// 资金变更状态。
  status            WalletFlowStatus @default(PENDING)
  /// 托管侧交易 ID（首次检测后回填，唯一）。
  custody_tx_id     String?          @unique
  /// 链上交易哈希（可用于链上追踪与对账）。
  tx_hash           String?
  /// 资产代码（如 USDT）。
  asset_code        String
  /// 链网络标识（如 TRON/TON）。
  network           String?
  /// 地址字段：充值时为入金地址，提现时为目标地址。
  address           String
  /// 本次资金变更金额。
  amount            Decimal          @db.Decimal(36, 18)
  /// 手续费金额（提现或特殊场景可能有值）。
  fee_amount        Decimal?         @db.Decimal(36, 18)
  /// 失败原因（仅失败场景写入）。
  fail_reason       String?
  /// 记录创建时间。
  created_at        DateTime         @default(now())
  /// 记录更新时间（状态推进、确认数变化时会自动更新）。
  updated_at        DateTime         @updatedAt

  @@index([wallet_account_id, status])
  @@index([tx_hash])
  @@index([address, asset_code])
  @@map("wallet_flow_records")
}

/// ========== 域4：卡资金桥接 ==========

/// 卡操作资金记录桥接表。
/// 用于关联移动端操作、caku 外部业务标识和本地钱包资金流水。
/// 该表不是独立账本：实际账务入账统一写入 WalletLedgerEntry，
/// 并通过 (business_type = CARD_OPERATION_RECORD, business_id = CardOperationRecord.id) 关联。
model CardOperationRecord {
  id                String                    @id @default(cuid())
  /// 钱包账户 ID（wallet_accounts.id）。
  wallet_account_id String
  /// 卡操作资金记录状态。
  status            CardOperationRecordStatus @default(PENDING)
  /// 幂等键（防止重复请求/重复扣款）。
  idempotency_key   String                    @unique
  /// 外部卡系统业务单号（唯一，回查用）。
  caku_ref_id       String?                   @unique
  /// 扣款资产代码（如 USDT）。
  token_asset_code  String
  /// 扣款资产金额。
  token_amount      Decimal                   @db.Decimal(36, 18)
  /// 法币币种（默认 USD）。
  fiat_currency     String                    @default("USD")
  /// 法币金额。
  fiat_amount       Decimal                   @db.Decimal(36, 2)
  /// 记录创建时间。
  created_at        DateTime                  @default(now())
  /// 记录更新时间。
  updated_at        DateTime                  @updatedAt
  /// 归属钱包账户关系。
  wallet_account    WalletAccount             @relation(fields: [wallet_account_id], references: [id], onDelete: Cascade)

  @@index([wallet_account_id, status])
  @@index([status])
  @@map("card_operation_records")
}
