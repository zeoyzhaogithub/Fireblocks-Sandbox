// ------------------------------------------------------
// User Management
// ------------------------------------------------------

model User {
  /// Unique identifier (UUID)
  id               String      @id @default(uuid())
  /// Primary login credential
  email            String      @unique
  /// Display name
  username         String
  /// Optional user alias
  nickname         String?
  /// URL to the user profile image
  avatar           String?
  /// Hashed password string
  password         String
  /// Account lifecycle status
  status           UserStatus  @default(ACTIVE)

  /// --- Account referral attributes ---
  referralCode     String?
  referralRules    Referral[]  @relation("UserReferralCodes")
  referredUsers    User[]      @relation("UserReferrals")

  /// --- Attribution source attribute ---
  joinedCode       String?     @map("joined_code")
  inviterId        String?     @map("inviter_id")
  inviter          User?       @relation("UserReferrals", fields: [inviterId], references: [id])


  // --- KYC/MFA Relation ---
  /// One-to-one：KYC 外键在 `Kyc.user_id`（且 `@unique`）
  kyc              Kyc?       @relation("UserKYCRecords")
  /// One-to-many：MFA 审计记录（表 `mfa_audit_logs`）
  mfa              Mfa[]      @relation("UserMFARecords")

  /// Fireblocks 交易快照（冗余 `user_id`，便于按用户查询）
  fireblocks_transaction_snapshots FireblocksTransactionSnapshot[]

  /// PIN-based verification for mobile devices
  pin              String? 

  // --- External Integrations ---
  /// One-to-one link to the user's Fireblocks wallet
  wallet           Wallet?

  /// Security authenticators (TOTP, Email, etc.)
  authenticators   Authenticator[]

  // --- Timestamps ---
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  @@index([status, joinedCode])
  @@index([joinedCode, inviterId])
  @@index([username])
  @@index([referralCode])
  @@index([inviterId])
  @@index([createdAt])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}
