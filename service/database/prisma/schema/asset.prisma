/// ======================================================
/// 5. Assets（资产与金库地址）
/// 职责：
/// - VaultAsset：用户在 Fireblocks 侧按网络/资产的充值地址
/// - Asset：平台内按 symbol 维度的用户余额账本
/// 典型业务时机：
/// - 开户同步地址、链上充值入账、余额调账
/// 依赖关系：
/// - 强依赖 User（user_id 外键）
/// ======================================================

model VaultAsset {
  id               String   @id @default(cuid())
  /// Fireblocks specific asset ticker
  asset_id         String
  /// Blockchain network name
  network          String
  /// Deposit/Vault address
  address          String

  user_id          String
  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@index([user_id])
}

model Asset {
  id               String   @id @default(cuid())
  /// Asset symbol (e.g., BTC, USDT)
  symbol           String
  user_id          String
  /// Available balance with high precision
  balance          Decimal  @db.Decimal(36, 18)

  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@unique([user_id, symbol]) // Prevents duplicate asset rows for same user
}
