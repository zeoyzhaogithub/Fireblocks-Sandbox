// ------------------------------------------------------
// Assets
// ------------------------------------------------------

model VaultAsset {
  id         String   @id @default(cuid())
  /// Fireblocks specific asset ticker
  assetId    String   @map("asset_id")
  /// Blockchain network name
  network    String
  /// Deposit/Vault address
  address    String

  walletId   String   @map("wallet_id")
  wallet     Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([walletId])
  @@index([assetId])
  @@index([address])
  @@index([network, assetId])
  @@map("vault_assets")
}

model Asset {
  id        String   @id @default(cuid())
  /// Asset symbol (e.g., BTC, USDT)
  symbol    String
  walletId  String   @map("wallet_id")

  /// Available balance with high precision
  balance   Decimal  @db.Decimal(36, 18) @default(0)
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([walletId, symbol]) // Prevents duplicate asset rows for same user
  @@index([symbol])
  @@map("assets")
}
