/// ======================================================
/// 0. Schema entry file
/// 职责：
/// - 定义 Prisma Client 生成配置与数据库连接源
/// - 不放业务模型，只放全局基础配置
/// ======================================================

generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}