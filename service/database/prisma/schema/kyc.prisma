/// ======================================================
/// 3. Identity & Compliance（KYC）
/// 职责：
/// - 存储 Sumsub 等供应商侧 applicant 与审核状态快照
/// 典型业务时机：
/// - 发起 KYC、Webhook 回调更新、人工复核结果落库
/// 依赖关系：
/// - 可选关联 User（user_id 唯一，可空表示尚未绑定内网用户）
/// ======================================================

model Kyc {
  id               Int       @id @default(autoincrement())
  user_id          String?   @unique
  /// Sumsub external system user reference
  external_user_id String
  /// Sumsub internal applicant reference
  applicant_id     String
  status           KycStatus @default(INITIAL)

  // --- Sumsub Response Metadata ---
  level_name       String?
  review_status    String?
  review_result    String?
  sandbox_mode     Boolean?
  event_update_at  DateTime? @db.Timestamptz(3)

  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  user             User?     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

enum KycStatus {
  INITIAL   // Created but not submitted
  PENDING   // Documentation submitted, awaiting review
  REJECTED  // Verification failed
  COMPLETED // Verification successful
  RETRY     // Resubmission required
}
