// ------------------------------------------------------
// Authenticator
// ------------------------------------------------------

model Authenticator {
  id             Int               @id @default(autoincrement())
  userId         String            @map("user_id")
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Type of authentication method
  type           AuthenticatorType

  // --- Security Credentials ---
  /// Shared secret or hashed code for verification
  secret         String?
  /// Associated email address or phone number
  identifier     String?

  // --- Status & Security ---
  /// Whether the MFA method is verified(initially false)
  verified       Boolean           @default(false)
  /// Whether the MFA method is currently enabled
  enabled        Boolean           @default(false)

  /// Lockout expiration time for security
  lockedUntil    DateTime?
  /// Consecutive failed login attempts
  failedAttempts Int               @default(0) @map("failed_attempts")
  /// Encrypted backup codes for recovery
  backupCodes    String?           @map("backup_codes")


  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, type])
  @@index([type])
  @@index([identifier])
  @@map("authenticators")
}

enum AuthenticatorType {
  TOTP         // Time-based One-Time Password
  TELEGRAM_OTP // Telegram-based verification
  EMAIL        // Email-based verification
}

model Mfa {
  id         BigInt    @id @default(autoincrement())
  userId     String    @map("user_id")
  user       User      @relation("UserMFARecords", fields: [userId], references: [id], onDelete: Cascade)

  /// The outcome of the MFA attempt
  status     MfaStatus @default(EXPIRED)
  /// The action triggered this MFA (e.g., "SENSITIVE_TRANSFER", "LOGIN")
  action     String
  /// The specific method used for this verification instance
  method     AuthenticatorType[]

  // --- Contextual Metadata ---
  /// Originating IP address of the request
  ip         String?

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@map("mfa_audit_logs")
}

enum MfaStatus {
  SUCCESS
  EXPIRED
}