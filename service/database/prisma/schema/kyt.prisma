model Kyt {
  /// Unique identifier for the KYT record
  id               String   @id @default(cuid())
  /// Reference to the internal platform user
  userId           String   @map("user_id")
  /// Unique identifier for the alert from the monitoring provider (e.g., Chainalysis, Elliptic)
  alertIdentifier  String   @map("alert_identifier")
  /// Original timestamp when the alert was triggered by the external provider
  alertCreatedAt   DateTime @map("alert_created_at")
  /// On-chain transaction hash associated with the risk alert
  transactionHash  String   @map("transaction_hash")
  /// The specific cryptocurrency or asset symbol (e.g., BTC, USDT)
  asset            String
  /// Full raw response payload from the KYT provider for audit purposes
  raw              Json

  // --- Timestamps ---
  /// Record creation timestamp in the local database
  createdAt DateTime @default(now()) @map("created_at")
  /// Record last update timestamp
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([transactionHash])
  @@index([alertIdentifier])
  @@index([asset])
  @@index([createdAt])
  @@map("kyt_alerts")
}
