{
  "name": "react-native",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "EXPO_NO_DEPENDENCY_VALIDATION=1 expo start -c",
