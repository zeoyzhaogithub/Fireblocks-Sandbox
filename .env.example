# Redis
REDIS_VERSION=latest
REDIS_HOST=localhost
REDIS_PORT=6379

# Server Ports
GATEWAY_PORT=3100
PROVIDER_PORT=4100
SCHEDULE_PORT=5100

# Provider — 充值资产列表 JSON
# 解析规则（见 DepositAssetsService）：若为相对路径，则与 process.cwd() 拼接；若为绝对路径则原样使用。
# 用 pnpm 在仓库根执行 dev/start 时，各子包脚本 cwd 一般为该包目录，故 provider 下常用：
#   DEPOSIT_ASSETS_CONFIG_PATH=config/deposit-assets.json
# 若进程 cwd 为仓库根（少见），请改为相对仓库根的路径或绝对路径，例如：
#   DEPOSIT_ASSETS_CONFIG_PATH=servers/provider/config/deposit-assets.json
#   DEPOSIT_ASSETS_CONFIG_PATH=/abs/path/to/deposit-assets.json
# DEPOSIT_ASSETS_CONFIG_PATH=config/deposit-assets.json

# Swagger
PROVIDER_SWAGGER_ENABLED=true
PROVIDER_SWAGGER_PATH=docs
GATEWAY_SWAGGER_ENABLED=true
GATEWAY_SWAGGER_PATH=docs

# PostgreSQL
# DATABASE_URL=postgresql://postgres:123456@localhost:5432/postgres
# POSTGRES_VERSION=latest
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=123456
# POSTGRES_DB=postgres


# Fireblocks
FIREBLOCKS_BASE_PATH=https://sandbox-api.fireblocks.io/v1
# FIREBLOCKS_BASE_URL=https://sandbox-api.fireblocks.io
FIREBLOCKS_API_KEY=your_api_key(your_sandbox_api_key)
FIREBLOCKS_SECRET_KEY=
FIREBLOCKS_PRIVATE_KEY_PATH=/absolute/path/to/fireblocks_secret.key

# SUMSUB
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET_KEY=
SUMSUB_BASE_URL=https://api.sumsub.com # https://api.sandbox.sumsub.com

# AWS SES Email Configuration
AWS_SES_SENDER=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=

# AWS S3 Object Storage Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=

# KYT Configuration（Chainalysis）
KYT_TOKEN=

# Coingecko Configuration(Price inquiry)
COINGECKO_API_KEY=

# Telegram gateway（Telegram API Token）
TELEGRAM_GATEWAY_TOKEN=