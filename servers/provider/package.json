{
  "name": "@server/provider",
  "version": "1.0.0",
  "main": "main.ts",
  "scripts": {
    "predev": "node ../../scripts/kill-ports.mjs 4100",
    "dev": "tsx watch src/main.ts",
    "prestart": "node ../../scripts/kill-ports.mjs 4100",
    "start": "tsx src/main.ts"
  },
  "dependencies": {
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/adapter-pg": "catalog:sql",
    "@service/database": "workspace:^",
    "@service/fireblocks": "workspace:^",
    "@service/redis": "workspace:^",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "otplib": "^12.0.1",
    "pg": "^8.16.3"
  },
  "microservice": {
    "transport": "REDIS",
    "options": {
      "host": "$REDIS_HOST",
      "port": "$REDIS_PORT"
    }
  },
  "service": {
    "port": 4100
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/pg": "^8.20.0"
  }
}
